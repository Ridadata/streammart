          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    CASE \n        WHEN event_type = 'pageview' THEN 1 \n        WHEN event_type = 'product_click' THEN 2 \n        WHEN event_type = 'add_to_cart' THEN 3 \n        WHEN event_type = 'purchase' THEN 4 \n        ELSE 5 \n    END AS stage_order,\n    event_type AS stage, \n    SUM(count) AS users \nFROM metrics_1min \nWHERE $__timeFilter(window_start)\n  AND event_type IN ('pageview', 'product_click', 'add_to_cart', 'purchase')\nGROUP BY event_type\nORDER BY stage_order ASC;",
          "refId": "A"
        }
