{
  "namespace": "com.streammart.events",
  "type": "record",
  "name": "PageView",
  "doc": "User page view event - triggered when user lands on any page",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique identifier for this event (UUID v4)"
    },
    {
      "name": "session_id",
      "type": "string",
      "doc": "Session identifier - groups events from same browsing session"
    },
    {
      "name": "user_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "User identifier - null if anonymous user"
    },
    {
      "name": "timestamp",
      "type": "long",
      "logicalType": "timestamp-millis",
      "doc": "Event timestamp in milliseconds since epoch"
    },
    {
      "name": "page_url",
      "type": "string",
      "doc": "Full URL of the page viewed"
    },
    {
      "name": "page_type",
      "type": {
        "type": "enum",
        "name": "PageType",
        "symbols": ["HOME", "CATEGORY", "PRODUCT", "CART", "CHECKOUT", "SEARCH"]
      },
      "doc": "Type of page viewed"
    },
    {
      "name": "referrer",
      "type": ["null", "string"],
      "default": null,
      "doc": "Referrer URL - where user came from"
    },
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": ["DESKTOP", "MOBILE", "TABLET"]
      },
      "doc": "Type of device used"
    },
    {
      "name": "user_agent",
      "type": "string",
      "doc": "Browser user agent string"
    },
    {
      "name": "ip_address",
      "type": "string",
      "doc": "User IP address (anonymized in production)"
    }
  ]
}
