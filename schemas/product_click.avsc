{
  "namespace": "com.streammart.events",
  "type": "record",
  "name": "ProductClick",
  "doc": "User clicked on a product - indicates interest",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique identifier for this event (UUID v4)"
    },
    {
      "name": "session_id",
      "type": "string",
      "doc": "Session identifier"
    },
    {
      "name": "user_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "User identifier - null if anonymous"
    },
    {
      "name": "timestamp",
      "type": "long",
      "logicalType": "timestamp-millis",
      "doc": "Event timestamp in milliseconds since epoch"
    },
    {
      "name": "product_id",
      "type": "string",
      "doc": "Unique product identifier (SKU)"
    },
    {
      "name": "product_name",
      "type": "string",
      "doc": "Human-readable product name"
    },
    {
      "name": "product_category",
      "type": "string",
      "doc": "Product category (Electronics, Clothing, etc.)"
    },
    {
      "name": "product_price",
      "type": "double",
      "doc": "Product price in USD"
    },
    {
      "name": "click_position",
      "type": "int",
      "doc": "Position of product in list (1-indexed)"
    },
    {
      "name": "list_type",
      "type": {
        "type": "enum",
        "name": "ListType",
        "symbols": ["SEARCH_RESULTS", "CATEGORY_PAGE", "RECOMMENDATIONS", "BESTSELLERS", "RELATED_PRODUCTS"]
      },
      "doc": "Context where product was clicked"
    },
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": ["DESKTOP", "MOBILE", "TABLET"]
      },
      "doc": "Type of device used"
    }
  ]
}
