# ============================================================================
# StreamMart Environment Variables — Copy to .env and fill in real values
# ============================================================================

# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streammart
POSTGRES_USER=streammart_user
POSTGRES_PASSWORD=change_me_strong_password

# MinIO Configuration (S3-compatible data lake)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me_access_key
MINIO_SECRET_KEY=change_me_secret_key
MINIO_BUCKET=raw-events

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://streammart_user:change_me_strong_password@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
# Without this, Airflow stores connection passwords in its metadata DB
# unencrypted (confirmed live: "empty cryptography key - values will not be
# stored encrypted" warning on airflow-init). Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=change_me_generate_a_real_fernet_key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_strong_password

# Grafana Configuration (web UI login — not the app database password)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# pgAdmin Configuration (optional DB browser UI)
PGADMIN_DEFAULT_EMAIL=admin@streammart.dev
PGADMIN_DEFAULT_PASSWORD=change_me_strong_password

# Spark Configuration
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Monitoring
PROMETHEUS_RETENTION_DAYS=15

# Application Settings
EVENT_GENERATOR_RATE=2    # events per second per event type
LOG_LEVEL=INFO
